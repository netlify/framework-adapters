{
  "name": "@netlify/vite-plugin-tanstack-start",
  "version": "1.3.19",
  "description": "Vite plugin for TanStack Start on Netlify",
  "type": "module",
  "engines": {
    "node": "^22.22.0 || >=24.0.0"
  },
  "main": "./dist/main.js",
  "exports": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "tsdown",
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "tsgo --noEmit",
    "test:dev": "vitest",
    "test:ci": "vitest run",
    "dev": "tsdown --watch",
    "publint": "npx -y publint --strict"
  },
  "keywords": [
    "netlify",
    "tanstack",
    "tanstack-start",
    "vite-plugin",
    "dev",
    "build"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/netlify/framework-adapters.git",
    "directory": "packages/vite-plugin-tanstack-start"
  },
  "bugs": {
    "url": "https://github.com/netlify/framework-adapters/issues"
  },
  "author": "Netlify Inc.",
  "devDependencies": {
    "@netlify/framework-adapters-test-utils": "*",
    "@types/node": "^22.18.5",
    "playwright": "^1.61.0",
    "tsdown": "^0.23.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@netlify/vite-plugin": "3.0.1"
  },
  "peerDependencies": {
    "@tanstack/react-start": ">=1.132.0",
    "@tanstack/solid-start": ">=1.132.0",
    "vite": ">=7.0.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-start": {
      "optional": true
    },
    "@tanstack/solid-start": {
      "optional": true
    }
  }
}
