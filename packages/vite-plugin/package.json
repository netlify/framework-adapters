{
  "name": "@netlify/vite-plugin",
  "version": "3.0.0",
  "description": "Vite plugin with a local emulation of the Netlify environment",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/main.js",
  "exports": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "tsup-node",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:dev": "vitest",
    "test:ci": "vitest run",
    "dev": "tsup-node --watch",
    "publint": "npx -y publint --strict"
  },
  "keywords": [
    "netlify",
    "vite-plugin",
    "dev"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/netlify/framework-adapters.git",
    "directory": "packages/vite-plugin"
  },
  "bugs": {
    "url": "https://github.com/netlify/framework-adapters/issues"
  },
  "author": "Netlify Inc.",
  "devDependencies": {
    "@netlify/framework-adapters-test-utils": "*",
    "@types/node": "^20.19.43",
    "normalize-package-data": "^8.0.0",
    "playwright": "^1.61.0",
    "tsup": "^8.5.1",
    "vite": "^6.4.3",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@netlify/dev": "^5.0.1",
    "@netlify/dev-utils": "^5.0.0",
    "dedent": "^1.7.2"
  },
  "peerDependencies": {
    "vite": "^5 || ^6 || ^7 || ^8"
  }
}
