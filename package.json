{
  "name": "netlify-framework-adapters-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/test-utils",
    "packages/angular-runtime",
    "packages/nuxt-module",
    "packages/vite-plugin",
    "packages/vite-plugin-tanstack-start"
  ],
  "version": "0.0.0",
  "scripts": {
    "dev": "node scripts/parallel.js npm run dev",
    "prepare": "husky",
    "lint": "eslint --cache",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write .",
    "format:ci": "prettier --check .",
    "test:vite-ecosystem-ci": "COPY_OVERRIDES_TO_FIXTURES=true npm run test -w packages/vite-plugin"
  },
  "keywords": [],
  "license": "MIT",
  "devDependencies": {
    "@eslint/compat": "^1.2.9",
    "@eslint/js": "^9.27.0",
    "@vitest/eslint-plugin": "^1.6.20",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "17.21.3",
    "execa": "^9.6.1",
    "husky": "^9.1.7",
    "prettier": "^3.8.4",
    "typescript-eslint": "^8.61.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "12.1.0",
      "onFail": "warn"
    }
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true,
    "fsevents@2.3.2": true,
    "@parcel/watcher@2.5.6": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true,
    "esbuild@0.28.1": true,
    "netlify-cli@27.3.0": true,
    "unix-dgram@2.0.7": true
  }
}
